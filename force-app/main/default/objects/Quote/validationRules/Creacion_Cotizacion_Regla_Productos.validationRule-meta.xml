<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Creacion_Cotizacion_Regla_Productos</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    AND(
        ISNEW(),
        OR(
            ISBLANK(Opportunity.TotalOpportunityQuantity),
            Opportunity.TotalOpportunityQuantity &lt;= 0
        )
    )
)</errorConditionFormula>
    <errorMessage>Para crear una Cotización, la Oportunidad asociada debe tener al menos un producto agregado.</errorMessage>
</ValidationRule>
