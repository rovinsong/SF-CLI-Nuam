<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cambio_Estado_No_Permitido</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISCHANGED(Status),
    TEXT(PRIORVALUE(Status)) = &quot;Aceptada&quot;,
    TEXT(Status) = &quot;CotizacionDisponible&quot;
)</errorConditionFormula>
    <errorMessage>Una cotización no puede pasar del estado Aceptada a Disponible</errorMessage>
</ValidationRule>
