<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Campos_Obligatorios_Estado_No_Contactado</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status, &quot;No contactado&quot;) &amp;&amp; 
(
    ISPICKVAL(Status, &quot;&quot;) || 
    ISPICKVAL(LeadSource, &quot;&quot;)
)</errorConditionFormula>
    <errorMessage>Cuando el estado es &apos;No contactado&apos;, los campos &apos;Estado del Candidato&apos; y &apos;Origen del Candidato&apos; son obligatorios.</errorMessage>
</ValidationRule>
