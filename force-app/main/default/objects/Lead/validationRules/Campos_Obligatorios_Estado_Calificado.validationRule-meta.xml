<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Campos_Obligatorios_Estado_Calificado</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status, &quot;Calificado&quot;) &amp;&amp;
(
    ISBLANK(FirstName) || 
    ISBLANK(Email) || 
    ISBLANK(MobilePhone)
)</errorConditionFormula>
    <errorMessage>Para calificar un candidato, es obligatorio completar el Nombre, Correo electrónico y Teléfono móvil.</errorMessage>
</ValidationRule>
