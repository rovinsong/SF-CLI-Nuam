<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validar_Estado_Creacion_No_Contactado</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISNEW(),
    NOT(ISPICKVAL(Status, &quot;No contactado&quot;))
)</errorConditionFormula>
    <errorDisplayField>Status</errorDisplayField>
    <errorMessage>Error de creación: Los nuevos registros deben iniciarse obligatoriamente con el estado No contactado.</errorMessage>
</ValidationRule>
