<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Campos_Obligatorios_Estado_Descartado</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status, &quot;Descartado&quot;) &amp;&amp; 
(
    ISPICKVAL(MotivoDeDescarte__c, &quot;&quot;)
)</errorConditionFormula>
    <errorDisplayField>MotivoDeDescarte__c</errorDisplayField>
    <errorMessage>Cuando el estado es &apos;Descartado&apos;, los campos &apos;Motivo de Descarte&apos; es obligatorio.</errorMessage>
</ValidationRule>
