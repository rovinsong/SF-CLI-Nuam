<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contacto_Nuevo_Asociado_a_Cuenta</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISNEW(),
    ISBLANK(AccountId)
)</errorConditionFormula>
    <errorDisplayField>AccountId</errorDisplayField>
    <errorMessage>No se puede crear un contacto sin asociarlo a una cuenta. Por favor, seleccione una cuenta válida</errorMessage>
</ValidationRule>
